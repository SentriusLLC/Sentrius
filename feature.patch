+<script>
+document.addEventListener('DOMContentLoaded', function() {
+    const templatesContainer = document.getElementById('templates-container');
+    const createTemplateBtn = document.getElementById('createTemplateBtn');
+    const saveTemplateBtn = document.getElementById('saveTemplateBtn');
+    const templateModal = new bootstrap.Modal(document.getElementById('templateModal'));
+    const csrfToken = document.getElementById('csrf-token').textContent;
+
+    let editingTemplateId = null;
+
+    // Load templates on page load
+    loadTemplates();
+
+    createTemplateBtn.addEventListener('click', function() {
+        editingTemplateId = null;
+        clearForm();
+        document.getElementById('templateModalLabel').textContent = 'Create Agent Template';
+        templateModal.show();
+    });
+
+    saveTemplateBtn.addEventListener('click', function() {
+        saveTemplate();
+    });
+
+    function loadTemplates() {
+        fetch('/api/v1/agent/templates')
+            .then(response => response.json())
+            .then(templates => {
+                displayTemplates(templates);
+            })
+            .catch(error => {
+                console.error('Error loading templates:', error);
+                templatesContainer.innerHTML = '<div class="alert alert-danger">Failed to load templates</div>';
+            });
+    }
+
+    function displayTemplates(templates) {
+        if (templates.length === 0) {
+            templatesContainer.innerHTML = '<div class="alert alert-info" style="grid-column: 1 / -1;">No templates configured yet. Create your first template to get started.</div>';
+            return;
+        }
+
+        templatesContainer.innerHTML = templates.map(template => `
+            <div class="template-card">
+                <div class="template-icon">
+                    <i class="fas ${template.icon || 'fa-robot'}"></i>
+                </div>
+                <h5>${template.name}
+                    ${template.systemTemplate ? '<span class="system-badge">System</span>' : ''}
+                </h5>
+                <div class="template-category">${template.category || 'Uncategorized'}</div>
+                <p class="text-muted">${template.description}</p>
+                <div class="template-actions">
+                    <button class="btn btn-sm btn-primary launch-btn" data-template-id="${template.id}">
+                        <i class="fas fa-rocket"></i> Launch
+                    </button>
+                    ${!template.systemTemplate ? `
+                        <button class="btn btn-sm btn-secondary edit-btn" data-template-id="${template.id}">
+                            <i class="fas fa-edit"></i> Edit
+                        </button>
+                        <button class="btn btn-sm btn-danger delete-btn" data-template-id="${template.id}">
+                            <i class="fas fa-trash"></i> Delete
+                        </button>
+                    ` : ''}
+                </div>
+            </div>
+        `).join('');
+
+        // Attach event listeners
+        document.querySelectorAll('.launch-btn').forEach(btn => {
+            btn.addEventListener('click', function() {
+                const templateId = this.getAttribute('data-template-id');
+                launchAgentFromTemplate(templateId);
+            });
+        });
+
+        document.querySelectorAll('.edit-btn').forEach(btn => {
+            btn.addEventListener('click', function() {
+                const templateId = this.getAttribute('data-template-id');
+                editTemplate(templateId);
+            });
+        });
+
+        document.querySelectorAll('.delete-btn').forEach(btn => {
+            btn.addEventListener('click', function() {
+                const templateId = this.getAttribute('data-template-id');
+                deleteTemplate(templateId);
+            });
+        });
+    }
+
+    function launchAgentFromTemplate(templateId) {
+        const agentName = prompt('Enter a name for the new agent:');
+        if (!agentName) {
+            return;
+        }
+
+        // Validate agent name
+        if (!/^[a-z0-9-]+$/.test(agentName)) {
+            alert('Agent name must contain only lowercase letters, numbers, and hyphens');
+            return;
+        }
+
+        fetch(`/api/v1/agent/templates/${templateId}/launch?agentName=${encodeURIComponent(agentName)}`, {
+            method: 'POST',
+            headers: {
+                'X-CSRF-TOKEN': csrfToken
+            }
+        })
+        .then(response => response.json())
+        .then(data => {
+            if (data.status === 'prepared') {
+                alert(`Agent launch prepared!\n\nAgent: ${data.agentName}\nTemplate: ${data.templateName}\nType: ${data.agentType}\n\n${data.message}`);
+            } else {
+                alert('Agent launch initiated. Check the agent list for status.');
+            }
+        })
+        .catch(error => {
+            console.error('Error launching agent:', error);
+            alert('Failed to launch agent. Please check the logs for details.');
+        });
+    }
+
+    function editTemplate(templateId) {
+        fetch(`/api/v1/agent/templates/${templateId}`)
+            .then(response => response.json())
+            .then(template => {
+                editingTemplateId = templateId;
+                document.getElementById('templateModalLabel').textContent = 'Edit Agent Template';
+                document.getElementById('templateId').value = template.id;
+                document.getElementById('templateName').value = template.name;
+                document.getElementById('templateDescription').value = template.description;
+                document.getElementById('templateAgentType').value = template.agentType;
+                document.getElementById('templateCategory').value = template.category || 'Other';
+                document.getElementById('templateIcon').value = template.icon || '';
+                document.getElementById('templateDisplayOrder').value = template.displayOrder;
+                document.getElementById('templateConfig').value = template.defaultConfiguration || '';
+                document.getElementById('templatePurpose').value = template.purpose || '';
+                document.getElementById('templateGoals').value = template.goals || '';
+                document.getElementById('templateIdentity').value = template.identity || '';
+                document.getElementById('templateGuardrails').value = template.guardrails || '';
+                document.getElementById('templateTrustPolicyId').value = template.trustPolicyId || '';
+                document.getElementById('templateLaunchConfig').value = template.launchConfiguration || '';
+                document.getElementById('templateEnabled').checked = template.enabled;
+                templateModal.show();
+            })
+            .catch(error => {
+                console.error('Error loading template:', error);
+                alert('Failed to load template');
+            });
+    }
+
+    function deleteTemplate(templateId) {
+        if (!confirm('Are you sure you want to delete this template?')) {
+            return;
+        }
+
+        fetch(`/api/v1/agent/templates/${templateId}`, {
+            method: 'DELETE',
+            headers: {
+                'X-CSRF-TOKEN': csrfToken
+            }
+        })
+        .then(response => {
+            if (response.ok) {
+                loadTemplates();
+            } else {
+                return response.json().then(data => {
+                    throw new Error(data.error || 'Failed to delete template');
+                });
+            }
+        })
+        .catch(error => {
+            console.error('Error deleting template:', error);
+            alert('Error: ' + error.message);
+        });
+    }
+
+    function saveTemplate() {
+        const templateData = {
+            name: document.getElementById('templateName').value,
+            description: document.getElementById('templateDescription').value,
+            agentType: document.getElementById('templateAgentType').value,
+            category: document.getElementById('templateCategory').value,
+            icon: document.getElementById('templateIcon').value,
+            displayOrder: parseInt(document.getElementById('templateDisplayOrder').value),
+            defaultConfiguration: document.getElementById('templateConfig').value,
+            purpose: document.getElementById('templatePurpose').value,
+            goals: document.getElementById('templateGoals').value,
+            identity: document.getElementById('templateIdentity').value,
+            guardrails: document.getElementById('templateGuardrails').value,
+            trustPolicyId: document.getElementById('templateTrustPolicyId').value,
+            launchConfiguration: document.getElementById('templateLaunchConfig').value,
+            enabled: document.getElementById('templateEnabled').checked
+        };
+
+        // Validate JSON fields
+        const jsonFields = [
+            { key: 'defaultConfiguration', name: 'Default Configuration' },
+            { key: 'identity', name: 'Identity' },
+            { key: 'guardrails', name: 'Guardrails' },
+            { key: 'launchConfiguration', name: 'Launch Configuration' }
+        ];
+
+        for (const field of jsonFields) {
+            if (templateData[field.key]) {
+                try {
+                    JSON.parse(templateData[field.key]);
+                } catch (e) {
+                    alert(`Invalid JSON in ${field.name} field`);
+                    return;
+                }
+            }
+        }
+
+        const url = editingTemplateId 
+            ? `/api/v1/agent/templates/${editingTemplateId}`
+            : '/api/v1/agent/templates';
+        const method = editingTemplateId ? 'PUT' : 'POST';
+
+        fetch(url, {
+            method: method,
+            headers: {
+                'Content-Type': 'application/json',
+                'X-CSRF-TOKEN': csrfToken
+            },
+            body: JSON.stringify(templateData)
+        })
+        .then(response => {
+            if (response.ok) {
+                templateModal.hide();
+                loadTemplates();
+            } else {
+                return response.json().then(data => {
+                    throw new Error(data.error || 'Failed to save template');
+                });
+            }
+        })
+        .catch(error => {
+            console.error('Error saving template:', error);
+            alert('Error: ' + error.message);
+        });
+    }
+
+    function clearForm() {
+        document.getElementById('templateForm').reset();
+        document.getElementById('templateId').value = '';
+        document.getElementById('templateDisplayOrder').value = '0';
+        document.getElementById('templateEnabled').checked = true;
+    }
+});
+</script>
+
+</body>
+</html>
