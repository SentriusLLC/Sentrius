+    {{- end }}
+
     - host: "{{ .Values.subdomain }}"
       http:
         paths:
@@ -65,6 +186,7 @@ spec:
                 name: {{ .Release.Name }}-sentrius
                 port:
                   number: 8080
+
     - host: "{{ .Values.agentproxySubdomain }}"
       http:
         paths:
@@ -75,6 +197,7 @@ spec:
                 name: {{ .Release.Name }}-agentproxy
                 port:
                   number: 8080
+
     - host: "{{ .Values.rdpproxySubdomain }}"
       http:
         paths:
@@ -86,3 +209,4 @@ spec:
                 port:
                   number: 8080
 {{- end }}
