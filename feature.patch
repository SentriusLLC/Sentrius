+            container.html(html);
+        } else {
+            container.html('<p class="text-muted">No systems assigned yet.</p>');
+        }
+    }).fail(function(xhr) {
+        console.error('Error loading assignments:', xhr);
+        $('#assigned-systems-list').html('<p class="text-danger">Error loading assignments</p>');
+    });
+}
+
+function submitAssignment() {
+    var suggestionId = $('#assign-suggestion-id').val();
+    var selectedSystems = $('#system-select').val();
+    var remotePath = $('#remote-path').val();
+    var transferFile = $('#transfer-file-checkbox').is(':checked');
+    
+    if (!selectedSystems || selectedSystems.length === 0) {
+        alert('Please select at least one system');
+        return;
+    }
+    
+    if (!remotePath || remotePath.trim() === '') {
+        alert('Please provide a remote file path');
+        return;
+    }
+    
+    const csrfToken = document.getElementById("csrf-token").value;
+    
+    $.ajax({
+        url: '/api/v1/automation/suggestions/' + suggestionId + '/assign',
+        type: 'POST',
+        headers: {
+            'Content-Type': 'application/json',
+            "X-CSRF-TOKEN": csrfToken
+        },
+        contentType: 'application/json',
+        data: JSON.stringify({
+            systemIds: selectedSystems.map(Number),
+            remotePath: remotePath,
+            transferFile: transferFile
+        }),
+        success: function(response) {
+            var resultsHtml = '<strong>Assignment Results:</strong><ul>';
+            
+            if (response.results) {
+                response.results.forEach(function(result) {
+                    var status = result.assignmentStatus === 'success' ? 'success' : 'danger';
+                    resultsHtml += '<li class="text-' + status + '">';
+                    resultsHtml += 'System ID ' + result.systemId + ': ' + result.assignmentStatus;
+                    
+                    if (result.transferResult) {
+                        var transferStatus = result.transferResult.status === 'success' ? 'success' : 'warning';
+                        resultsHtml += ' | Transfer: <span class="text-' + transferStatus + '">' + result.transferResult.message + '</span>';
+                    }
+                    
+                    if (result.error) {
+                        resultsHtml += ' | Error: ' + result.error;
+                    }
+                    resultsHtml += '</li>';
+                });
+            }
+            
+            resultsHtml += '</ul>';
+            $('#assignment-results').html(resultsHtml).show();
+            
+            loadCurrentAssignments(suggestionId);
+            
+            $('#system-select').val([]);
+        },
+        error: function(xhr) {
+            var errorMsg = xhr.responseJSON ? xhr.responseJSON.message : 'Failed to assign automation';
+            $('#assignment-results')
+                .html('<strong class="text-danger">Error:</strong> ' + errorMsg)
+                .show();
+        }
+    });
+}
+
+function unassignSystem(suggestionId, systemId) {
+    if (!confirm('Remove this system assignment?')) {
+        return;
+    }
+    
+    const csrfToken = document.getElementById("csrf-token").value;
+    
+    $.ajax({
+        url: '/api/v1/automation/suggestions/' + suggestionId + '/assign/' + systemId,
+        type: 'DELETE',
+        headers: {
+            "X-CSRF-TOKEN": csrfToken
+        },
+        success: function(response) {
+            loadCurrentAssignments(suggestionId);
+            alert('System unassigned successfully');
+        },
+        error: function(xhr) {
+            alert('Error: ' + (xhr.responseJSON ? xhr.responseJSON.message : 'Failed to unassign system'));
+        }
+    });
+}
+
 </script>
 
 </body>
