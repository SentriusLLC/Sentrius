+#!/bin/bash
+
+SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+
+source ${SCRIPT_DIR}/base.sh
+source ${SCRIPT_DIR}/../../.azure.env
+
+# Azure Container Registry
+AZURE_REGISTRY="${AZURE_REGISTRY:-sentriusacr.azurecr.io}"
+
